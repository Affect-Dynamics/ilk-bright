!suite-blind/suite-summary.json

# Allow dataset directories
!suite-blind/*/
suite-blind/*/*

# Preserve individual dataset summaries
!suite-blind/*/*-isolation-summary.json
isolation-*/
*-pilot/
*-heldout/

